# Enquiry form — app/api/enquiry/route.ts
#
# Zoho Mail SMTP. praversetech.com is on Zoho's India data centre, so the host
# is smtp.zoho.in; accounts created outside India use smtp.zoho.com instead.
# Getting this wrong fails silently at send time.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465

# The mailbox that authenticates and appears as the From address.
SMTP_USER=inquiry@praversetech.com

# A Zoho APP-SPECIFIC password, not the account password.
# Zoho Mail → Settings → Security → App Passwords.
SMTP_PASS=

# Where enquiries land. Can differ from SMTP_USER.
ENQUIRY_TO=inquiry@praversetech.com

# Where job applications land — app/api/apply/route.ts
# Optional: falls back to ENQUIRY_TO if unset, so the form still works on a
# fresh deploy rather than failing closed.
CAREERS_TO=careers@praversetech.com

# Optional CRM hand-off — lib/enquiry.ts
# If set, every enquiry is also POSTed as JSON to this URL: reference, kind,
# name, email, company, phone, role, topic, subject, message, constraints,
# page, referrer, timestamp (ISO 8601), utm_source/medium/campaign/term/content.
# Works with any "catch hook" style receiver: Zapier (Webhooks by Zapier →
# Catch Hook), Make (Custom webhook), HubSpot workflows (webhook trigger), or a
# Google Apps Script web app appending to a Sheet. Must be https.
# A 4-second timeout applies; a slow or failing hook never fails the form.
# If SMTP fails but the webhook succeeds, the enquiry still counts as received.
ENQUIRY_WEBHOOK_URL=

# Optional. When set, sent as the X-Enquiry-Secret header, plus
# X-Enquiry-Signature: sha256=<HMAC-SHA256 of the raw body, hex>, so the
# receiver can reject requests that did not come from this site.
ENQUIRY_WEBHOOK_SECRET=
