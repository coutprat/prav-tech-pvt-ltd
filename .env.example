# Enquiry form — app/api/enquiry/route.ts
#
# Zoho Mail SMTP. praversetech.com is on Zoho's India data centre, so the host
# is smtp.zoho.in; accounts created outside India use smtp.zoho.com instead.
# Getting this wrong fails silently at send time.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465

# The mailbox that authenticates and appears as the From address.
SMTP_USER=inquiry@praversetech.com

# A Zoho APP-SPECIFIC password, not the account password.
# Zoho Mail → Settings → Security → App Passwords.
SMTP_PASS=

# Where enquiries land. Can differ from SMTP_USER.
ENQUIRY_TO=inquiry@praversetech.com

# Where job applications land — app/api/apply/route.ts
# Optional: falls back to ENQUIRY_TO if unset, so the form still works on a
# fresh deploy rather than failing closed.
CAREERS_TO=careers@praversetech.com

# Site assistant — app/api/chat/route.ts
# Without this the assistant returns 503 and the widget tells visitors to use
# the contact form, which is the correct failure mode. Nothing else breaks.
ANTHROPIC_API_KEY=
